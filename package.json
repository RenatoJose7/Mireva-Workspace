{
  "name": "mireva-workspace",
  "private": true,
  "version": "0.1.0",
  "bin": { "mireva": "./scripts/mireva.cjs" },
  "files": ["scripts/mireva.cjs", "scripts/mireva-agent.cjs", "README.md"],
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "hub": "pnpm --filter @mireva/hub start",
    "hub:deploy": "pnpm --filter @mireva/hub-cloudflare run deploy",
    "office": "pnpm --filter @mireva/office dev",
    "cli": "pnpm --filter @mireva/cli mireva"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
