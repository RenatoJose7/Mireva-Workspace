{
  "name": "mireva-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "hub": "pnpm --filter @mireva/hub start",
    "hub:deploy": "pnpm --filter @mireva/hub-cloudflare deploy",
    "cli": "pnpm --filter @mireva/cli mireva"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
